   ],
   "source": [
    "import numpy as np\n",
    "from scipy.signal import correlate, convolve\n",
    "\n",
    "x = np.array([1, 2, 3])\n",
    "h = np.array([0, 0.5, 1])\n",
    "conv = convolve(x, h, mode = 'full')\n",
    "corr = correlate(x, h, mode = 'full')\n",
    "print(\"Convolution:\", conv)\n",
    "print(\"Correlationtion:\", corr)"
   ]
  },
